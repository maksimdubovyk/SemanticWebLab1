# ===== РУЧНІ ЗМІНИ (лабораторна робота, п. 3) =====
# 1) Додано новий фільм Tenet (2020) та двох нових акторів.
# 2) До фільму Inception додано опис rdfs:comment.
# 3) Змінено рейтинг The Dark Knight: 9.0 -> 9.1.

film:Tenet a mo:Film ;
    dcterms:title "Tenet"@en ;
    mo:releaseYear 2020 ;
    mo:runtimeMinutes 150 ;
    mo:imdbRating 7.3 ;
    mo:directedBy person:ChristopherNolan ;
    mo:hasActor person:JohnDavidWashington,
        person:RobertPattinson ;
    mo:hasGenre genre:SciFi,
        genre:Action ;
    mo:producedIn country:USA,
        country:UK ;
    mo:producedBy studio:WarnerBros,
        studio:Syncopy .

person:JohnDavidWashington a mo:Actor, foaf:Person ;
    foaf:name "John David Washington" ;
    mo:birthYear 1984 ;
    mo:bornIn country:USA .

person:RobertPattinson a mo:Actor, foaf:Person ;
    foaf:name "Robert Pattinson" ;
    mo:birthYear 1986 ;
    mo:bornIn country:UK .

